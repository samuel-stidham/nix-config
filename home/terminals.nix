{ self, system, pkgs, config, lib, ... }:

let
  # Where this repo lives. One binding, so moving the checkout is one edit here
  # rather than a hunt through every module. Referenced by the zellij layout below.
  flakeRef = "${config.home.homeDirectory}/Code/samuel-stidham/nix-config";
in

# Terminals, themed Catppuccin Frappe and set to a Nerd Font. Ghostty and
# alacritty are the dev terminals. The Cinnamon default, gnome-terminal, stays
# on the system and is not themed here.

let
  nerdFont = "JetBrainsMono Nerd Font";

  # The attach-or-create launcher for the dev session, as a store command. Ghostty
  # opens into it (initial-command below) and the `servers` fish function calls it,
  # so both routes land in the SAME named session instead of racing to build two.
  #
  # In the store rather than referenced out of the checkout, for the reason
  # home/btrfs-scrub.nix spells out: a path into a git checkout breaks the moment
  # the repo moves, and this one is load-bearing for opening a terminal at all.
  # The trade is that editing the script needs a `home-manager switch` to take
  # effect, which is right for something reviewed once and then run constantly.
  devSession = pkgs.writeShellApplication {
    name = "dev-session";
    # zellij does the work; gnugrep and gawk parse the session list. Ghostty gives
    # initial-command a minimal PATH, so a missing tool here is a build error
    # rather than a terminal that will not open.
    runtimeInputs = with pkgs; [ zellij gnugrep gawk ];
    text = builtins.readFile ../scripts/dev-session.sh;
  };

  # THE NIX GHOSTTY CANNOT SEE THE GPU ON ITS OWN.
  #
  # pkgs.ghostty renders through nix's libglvnd. Every window died with
  #   error(opengl): no EGL driver could be loaded
  # and the daemon exited. Verified 2026-11-04 from a shell and from the
  # systemd unit alike, so it is the binary, not the launch path.
  #
  # The likely chain, by reading and not traced with LD_DEBUG=libs. The nix
  # libglvnd finds the host ICD /usr/share/glvnd/egl_vendor.d/10_nvidia.json,
  # whose library_path is the bare soname libEGL_nvidia.so.0. That resolves
  # through the RUNPATH /run/opengl-driver/lib to Ubuntu's unpatched driver.
  # Its own DT_NEEDED libs then find nothing, because the nix loader has no
  # ld.so.cache and no /usr/lib.
  #
  # Two obvious fixes do not work. LD_LIBRARY_PATH=/run/opengl-driver/lib gets
  # as far as "EGL vendor=NVIDIA" and then fails eglMakeCurrent with BadAccess.
  # Why is not traced. Running under nixGLNvidia renders. But nixGL exports
  # LD_LIBRARY_PATH with nix's libglvnd first, and every shell Ghostty opens
  # would inherit it. The host is glibc 2.43 and nix is 2.44. A host GL app
  # started from that shell would hit "GLIBC_2.44 not found". home/steam.nix
  # already unsets LD_LIBRARY_PATH for the same family of reason.
  #
  # What nixGL gets right is the driver: a nix-built copy of the exact host
  # version with RUNPATH patched, so its deps resolve by themselves. Pointing
  # __EGL_VENDOR_LIBRARY_FILENAMES at nixGL's ICD json, and nothing else, is
  # enough. Verified 2026-11-04: "EGL vendor=NVIDIA", no surface warning, and
  # no LD_LIBRARY_PATH change at all.
  #
  # The json path is read off the nixGLNvidia script at BUILD time rather than
  # written here. The driver version then stays pinned in flake.nix alone, as
  # home/graphics.nix requires. A layout change in nixGL fails this build with
  # a message. That beats a window failing at launch six months from now.
  #
  # The wrapper replaces bin/ghostty inside a symlinkJoin of the package. The
  # desktop entry, icons, terminfo and shell integration all come along. The
  # D-Bus service and systemd unit ship with the unwrapped store path baked in.
  # Those two files are rewritten to point at the wrapper. The desktop entry
  # needs no rewrite because its Exec is the bare name, resolved on PATH.
  #
  # The variable still reaches child shells unless stripped. A host EGL app
  # started from the terminal would then try to load the nix-glibc driver
  # through it. The `command` and `initial-command` lines in the ghostty config
  # below strip it with `env -u`.
  nixGLNvidia = self.legacyPackages.${system}.nixGLNvidia;
  ghosttyGL = pkgs.symlinkJoin {
    name = "ghostty-nvidia-egl-${pkgs.ghostty.version}";
    paths = [ pkgs.ghostty ];
    postBuild = ''
      glob=$(sed -n 's/^NVIDIA_JSON=(\(.*\))$/\1/p' ${nixGLNvidia}/bin/nixGLNvidia-*)
      set -- $glob
      if [ "$#" -ne 1 ] || [ ! -f "$1" ]; then
        echo "ghostty: expected one NVIDIA ICD json in nixGLNvidia, got: $glob" >&2
        exit 1
      fi
      icd=$1

      rm "$out/bin/ghostty"
      cat > "$out/bin/ghostty" <<EOF
      #!${pkgs.runtimeShell}
      # Generated by home/terminals.nix. See THE NIX GHOSTTY CANNOT SEE THE GPU.
      export __EGL_VENDOR_LIBRARY_FILENAMES=$icd
      exec ${pkgs.ghostty}/bin/ghostty "\$@"
      EOF
      chmod +x "$out/bin/ghostty"

      for f in share/dbus-1/services/com.mitchellh.ghostty.service \
               share/systemd/user/app-com.mitchellh.ghostty.service; do
        rm "$out/$f"
        sed "s|${pkgs.ghostty}/bin/ghostty|$out/bin/ghostty|" "${pkgs.ghostty}/$f" > "$out/$f"
      done
    '';
  };
in
{
  # Ghostty. It ships Catppuccin themes built in, so the theme is just a name.
  # This replaces the apt ghostty, so it is removed from apps.nix. The package is
  # listed once in home.packages at the bottom.
  xdg.configFile."ghostty/config".text = ''
    theme = Catppuccin Frappe
    font-family = ${nerdFont}
    font-size = 12
    # Do not flash the "cols x rows" box on every resize.
    resize-overlay = never
    # Ghostty's own (GTK) tabs along the bottom.
    gtk-tabs-location = bottom
    # Shift+Enter sends a newline (LF), so multiline input works in Claude Code
    # and other apps. Plain Enter still submits.
    keybind = shift+enter=text:\n
    # STRIP THE WRAPPER'S EGL OVERRIDE FROM EVERYTHING THE TERMINAL RUNS.
    #
    # ghosttyGL above exports __EGL_VENDOR_LIBRARY_FILENAMES so the nix binary
    # can reach the GPU. Children inherit it. A host EGL program started from
    # a shell would then try to dlopen a nix-glibc driver and lose EGL.
    #
    # The obvious fix is Ghostty's `env` option with an empty value, which the
    # docs describe as removing the key. It removes the key from Ghostty's OWN
    # additions only. Tested 2026-11-04: with `env = X=` set, the child shell
    # still carried X from the inherited environment. So both launch paths go
    # through `env -u` instead, which is exact.
    #
    # `shell:` forces /bin/sh -c, where $SHELL expands to the login shell. That
    # is the first rule of Ghostty's own default lookup. `exec` keeps the shell
    # a direct child of Ghostty, so prompt detection on close still works.
    # Verified 2026-11-04: the new window's fish had no __EGL_VENDOR_* in
    # /proc/PID/environ and still had GHOSTTY_SHELL_FEATURES, so shell
    # integration survived the detour.
    command = shell:exec env -u __EGL_VENDOR_LIBRARY_FILENAMES "''${SHELL:-fish}"

    # OPEN STRAIGHT INTO THE DEV SESSION.
    #
    # The ask was two GHOSTTY tabs, one per zellij layout. On 1.3.1 that was
    # missing plumbing. No startup option opened a second tab, `+new-window`
    # opened a WINDOW, and the D-Bus action list had no new-tab. Ghostty 1.4.0
    # added the plumbing. `ghostty +new-tab` exists, and the running instance's
    # D-Bus action list now carries new-tab. Checked 2026-11-04 with
    # `ghostty +help` and `busctl --user call com.mitchellh.ghostty
    # /com/mitchellh/ghostty org.gtk.Actions List`. The 1.4.0 option list still
    # has no setting that opens a second tab at startup. A two-tab start would
    # mean a wrapper firing +new-tab after the first window maps, which is the
    # same race the xdotool route had.
    #
    # So the two tabs stay ZELLIJ's, from the servers layout below: tab one the
    # 2x2 grid, tab two a single full-window pane. Same shape, one process
    # cheaper, and it survives Ghostty upgrades because it does not depend on
    # Ghostty.
    #
    # initial-command, NOT command. command would apply to every surface, so
    # ctrl+shift+t would open another zellij inside the terminal instead of a
    # shell. initial-command applies only to the first surface of each Ghostty
    # process, which is exactly "when I open Ghostty, put me in my session".
    initial-command = env -u __EGL_VENDOR_LIBRARY_FILENAMES ${devSession}/bin/dev-session
  '';

  # THE MENU LAUNCH MUST FIND A SYSTEMD UNIT.
  #
  # Ghostty's desktop entry is DBusActivatable. A launch from the Cinnamon menu
  # does not run the Exec line. It asks the session bus to activate
  # com.mitchellh.ghostty. The bus service file beside the desktop entry names
  # SystemdService=app-com.mitchellh.ghostty.service, so dbus-broker asks
  # systemd to start that unit. systemd looks for it on UnitPath. UnitPath is
  # fixed at user-manager start from a bare XDG_DATA_DIRS, before environment.d
  # adds ~/.nix-profile/share. The unit this package ships under
  # share/systemd/user is therefore invisible to systemd. The bus service file
  # next to it IS visible, because dbus-broker reads XDG_DATA_DIRS later.
  #
  # The failure was silent and pointed the wrong way. The apt ghostty 1.3.1
  # from the ghostty-ubuntu project shipped the same unit under
  # /usr/lib/systemd/user, which is always on UnitPath. So every menu launch
  # activated the apt daemon. The 1.4.0 in ~/.nix-profile sat unused while
  # `ghostty +version` at a prompt said 1.4.0, because PATH and the bus
  # disagreed. busctl showed /usr/bin/ghostty owning the name. It also hid
  # the GPU problem above, since the apt build used host libglvnd.
  #
  # The obvious fix, removing the apt package, leaves activation pointing at a
  # unit systemd cannot find. GIO is documented to fall back to the Exec line
  # then, which was not tested here and would skip the daemon on every launch.
  # Linking the package's own unit into ~/.config/systemd/user puts it on the
  # one directory systemd always searches. It links the package file rather
  # than a hand-written unit. The ExecStart store path and any upstream unit
  # change then follow the package on every switch. No Install section, so the
  # daemon starts on first launch rather than at login. The apt unit did the
  # same.
  #
  # The unit is ghosttyGL's rewritten copy, so ExecStart is the wrapper.
  #
  # Verified on 2026-11-04 after `home-manager switch`. `systemctl --user cat`
  # shows the unit under ~/.config/systemd/user. `gtk-launch
  # com.mitchellh.ghostty` starts the unit and spawns the shell with no opengl
  # warning in the journal. `busctl --user status com.mitchellh.ghostty`
  # reports the /nix/store ghostty-1.4.0 binary as the name owner.
  xdg.configFile."systemd/user/app-com.mitchellh.ghostty.service" =
    lib.mkIf pkgs.stdenv.hostPlatform.isLinux {
      source = "${ghosttyGL}/share/systemd/user/app-com.mitchellh.ghostty.service";
    };

  # Alacritty. Font here, colors from the catppuccin module.
  programs.alacritty = {
    enable = true;
    settings.font.normal.family = nerdFont;
  };
  catppuccin.alacritty.enable = true;

  # Zellij, the one terminal multiplexer. Panes, tabs, floating, and stacked
  # resize are all built in, which is where several AI agent sessions run side by
  # side. Confirmed 0.45.0. It ships Catppuccin themes built in, so the Frappe
  # theme is just a name, no external module needed. (rmux was dropped: it is a
  # standalone tmux-compatible multiplexer, not a layer over zellij, so it just
  # duplicated zellij's job.)
  programs.zellij = {
    enable = true;
    settings.theme = "catppuccin-frappe";
  };

  # "servers" layout: boot the whole dev backend at once.
  #
  # Tab 1 (servers): a 2x2 grid. Left column holds the two process-compose stacks
  # stacked one above the other (services on top, sites below). Right column is
  # two free shells; the top-right one is focused so you land in a working
  # terminal. close_on_exit keeps a crashed stack visible instead of vanishing.
  # Tab 2 (term): a single full-window terminal.
  #
  # Launch with the `servers` fish function (fish.nix), which names the session so
  # a second launch attaches instead of starting a conflicting copy.
  xdg.configFile."zellij/layouts/servers.kdl".text = ''
    // zellij --layout servers  (or the `servers` fish function)
    layout {
        tab name="servers" focus=true {
            pane split_direction="vertical" {
                pane split_direction="horizontal" {
                    // The flake ref is built from homeDirectory and flakeDir,
                    // not hardcoded. This pointed at ~/nix-config and broke the
                    // moment the repo moved under ~/Code/samuel-stidham.
                    pane command="nix" close_on_exit=false {
                        args "run" "${flakeRef}#services"
                    }
                    pane command="nix" close_on_exit=false {
                        args "run" "${flakeRef}#sites"
                    }
                }
                pane split_direction="horizontal" {
                    pane focus=true
                    pane
                }
            }
        }
        tab name="term" {
            pane
        }
    }
  '';

  # Guarded to Linux. The flake applies this home.nix to aarch64-darwin too, and
  # `pkgs.ghostty`, inside ghosttyGL, carries Linux-only `meta.platforms`.
  # Forcing it on darwin throws "not available on the requested hostPlatform"
  # and aborts eval. On macOS Ghostty ships as a Homebrew cask outside Nix, so
  # there is nothing to install here anyway. lib.optionals drops the package to
  # an empty list off Linux. The ghostty config file above stays unguarded on
  # purpose, since a cask Ghostty would still read ~/.config/ghostty.
  # Unverified on darwin, no such machine available.
  #
  # devSession is OUTSIDE the guard on purpose. It is a shell script over zellij,
  # and zellij is enabled unguarded above, so it builds and runs on darwin too. It
  # is in home.packages, not merely referenced by initial-command, because the
  # `servers` fish function calls it by name from PATH.
  home.packages =
    [ devSession ]
    ++ lib.optionals pkgs.stdenv.hostPlatform.isLinux [ ghosttyGL ];
}
